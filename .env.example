# Discord Bot token (required)
# Copy from Discord Developer Portal > Bot settings
DISCORD_TOKEN=your_bot_token_here

# Discord text channel ID to upload chunks to (required)
# Right-click the channel → "Copy ID" (requires Developer Mode)
DISCORD_CHANNEL_ID=your_channel_id_here

# ── Optional ──────────────────────────────────────────────────────────────────

# Maximum chunk size (bytes), default: 5242880 (5 MB)
# Discord free server attachment limit: 25 MB
# CHUNK_SIZE=5242880

# Number of retries on upload failure, default: 3
# UPLOAD_RETRIES=3

# Wait time before retry (ms), default: 2000
# RETRY_DELAY_MS=2000
