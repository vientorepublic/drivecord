# Discord Bot 토큰 (필수)
# Discord Developer Portal > 봇 설정에서 복사
DISCORD_TOKEN=your_bot_token_here

# 청크를 업로드할 Discord 텍스트 채널 ID (필수)
# 채널 우클릭 → "ID 복사" (개발자 모드 활성화 필요)
DISCORD_CHANNEL_ID=your_channel_id_here

# ── 선택 옵션 ─────────────────────────────────────────────────────────────────

# 청크 최대 크기 (bytes), 기본값: 5242880 (5 MB)
# Discord 무료 서버 첨부파일 한도: 25 MB
# CHUNK_SIZE=5242880

# 업로드 실패 시 재시도 횟수, 기본값: 3
# UPLOAD_RETRIES=3

# 재시도 전 대기 시간 (ms), 기본값: 2000
# RETRY_DELAY_MS=2000
